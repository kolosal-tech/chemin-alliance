// Chemin d'Alliance - schéma Prisma v1
// Données religieuses/familiales = données sensibles RGPD (art. 9).
// Chaque champ sensible porte un VisibilityLevel ; les champs *Encrypted
// sont chiffrés applicativement (AES-256-GCM, lib/security/crypto.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum VisibilityLevel {
  PUBLIC_CONTROLLED
  AFTER_MATCH
  AFTER_DIALOGUE
  AFTER_DISCERNMENT
  COACH_ONLY
  PRIVATE
  MANUAL_SHARE
}

enum FaithVertical {
  CHRISTIAN_EVANGELICAL
  CHRISTIAN_CATHOLIC
  OTHER
}

enum AllianceStage {
  DISCOVERY
  DIALOGUE
  DISCERNMENT
  ACCOMPANIMENT
  COMMITMENT
  MARRIAGE_PREPARATION
  CLOSED
}

enum ContactExchangeStatus {
  NOT_ALLOWED
  AVAILABLE
  REQUESTED
  ACCEPTED
  DECLINED
  REVOKED
}

enum UserRole {
  USER
  ADMIN
}

enum MatchStatus {
  PENDING
  ACTIVE
  CLOSED
}

enum MessageKind {
  USER
  SYSTEM
}

enum ModerationStatus {
  SAFE
  BLOCKED
  FLAGGED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum LifeSeason {
  JOURNEY
  ENGAGED
  MARRIED
  PARENTS
}

enum CoupleSpaceStatus {
  PENDING
  ACTIVE
}

enum ConsentType {
  SENSITIVE_DATA_PROCESSING
  TERMS_OF_SERVICE
  COUPLE_COACH_SHARING
  CONTACT_EXCHANGE
  AGENT_PROFILING
  AI_COACH_INTERACTION
}

model User {
  id                    String      @id @default(cuid())
  email                 String      @unique
  passwordHash          String
  displayName           String
  age                   Int
  gender                String?
  role                  UserRole    @default(USER)
  // Profil humain (defaut) ou Compagnon IA badge, vivant nativement dans la
  // Decouverte. Les Compagnons ne sont jamais comptes comme un vrai match.
  kind                  ProfileKind @default(HUMAN)
  locale                String      @default("fr")
  rulesetId             String      @default("christian_evangelical_default")
  season                LifeSeason  @default(JOURNEY)
  isVerified            Boolean     @default(false)
  emailVerifyToken      String?     @unique
  emailVerifyExpires    DateTime?
  passwordResetToken    String?     @unique
  passwordResetExpires  DateTime?
  photoUrl              String?
  photoBlurredByDefault Boolean     @default(true)
  photoBlurhash         String?

  cityApprox         String?
  country            String?
  phone              String?
  phoneVerified      Boolean   @default(false)
  stripeCustomerId   String?   @unique
  subscriptionStatus String?
  lastDevotionDate   DateTime?
  currentStreak      Int       @default(0)
  longestStreak      Int       @default(0)
  onboardingDoneAt   DateTime?
  // Revocation des sessions JWT : incremente a chaque changement/reset de mot de
  // passe. Le claim `sv` du jeton doit correspondre a cette valeur (verifie dans
  // getSessionUser), sinon la session est consideree invalide. Rend les jetons
  // deja emis (7j de validite) revocables sans blacklist cote serveur.
  sessionVersion     Int       @default(0)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  faithProfile          FaithProfile?
  relationshipProfile   RelationshipProfile?
  privacySettings       PrivacySettings?
  consents              Consent[]
  messages              Message[]
  matchesA              Match[]                @relation("MatchUserA")
  matchesB              Match[]                @relation("MatchUserB")
  allianceAnswers       AllianceAnswer[]
  reportsMade           Report[]               @relation("Reporter")
  reportsReceived       Report[]               @relation("ReportTarget")
  blocksMade            Block[]                @relation("Blocker")
  blocksReceived        Block[]                @relation("Blocked")
  passesMade            Pass[]                 @relation("Passer")
  passesReceived        Pass[]                 @relation("Passed")
  phoneVerifications    PhoneVerification[]
  bookings              Booking[]
  aiCoachUsages         AiCoachUsage[]
  coachMessages         CoachMessage[]
  aiCoachTransferLeases AiCoachTransferLease[]
  agentInsights         AgentInsight[]
  coupleSpaceA          CoupleSpace?           @relation("CoupleUserA")
  coupleSpaceB          CoupleSpace?           @relation("CoupleUserB")
  coupleMessages        CoupleMessage[]        @relation("CoupleMessageSender")
  pushSubscriptions     PushSubscription[]
  sponsor               Sponsor?               @relation("UserSponsor")
  blessings             Blessing[]             @relation("BlessingUser")
  aiCompanionMeta       AiCompanionMeta? // present si kind == AI_COMPANION
  initiatedGameRounds   GameRound[]            @relation("GameRoundInitiator")
  gameRoundAnswers      GameRoundAnswer[]      @relation("GameRoundAnswerUser")

  // Vivier de matching : getSuggestions (lib/matching.ts) filtre TOUJOURS sur
  // deletedAt + season + isVerified ; gender est optionnel (spread conditionnel,
  // absent quand me.gender est null). Colonnes toujours filtrées en tête pour
  // que Postgres restreigne le vivier avant le filtre optionnel.
  @@index([deletedAt, season, isVerified, gender])
}

// Blocage user-à-user - GRATUIT À VIE (doctrine, lib/payments/entitlements).
// Un blocage rend les deux personnes mutuellement invisibles (matching) et
// coupe tout échange. Jamais derrière un paywall, jamais de raison demandée.
model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// Passage unilatéral : je passe un profil et ne le revois plus dans MES
// suggestions. NON réciproque (≠ Block) : l'autre peut encore m'être proposé.
// GRATUIT À VIE (doctrine, lib/payments/entitlements -> "pass_user").
model Pass {
  id        String   @id @default(cuid())
  passerId  String
  passer    User     @relation("Passer", fields: [passerId], references: [id], onDelete: Cascade)
  passedId  String
  passed    User     @relation("Passed", fields: [passedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([passerId, passedId])
  @@index([passedId])
}

// Vérification du numéro de téléphone (anti-bot). Code à usage unique, haché,
// expirant. GRATUIT. L'envoi SMS est dormant tant qu'aucun prestataire (Twilio…)
// n'est configuré en env - voir lib/sms.ts.
model PhoneVerification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

// Espace Couple - la vie d'alliance APRÈS le mariage (saisons Mariés/Parents).
// Créé depuis un match avancé ("nous nous sommes mariés") ou par code
// d'invitation pour les couples déjà mariés hors plateforme.
// Un utilisateur en saison MARRIED/PARENTS est invisible du matching.
model CoupleSpace {
  id      String            @id @default(cuid())
  userAId String            @unique
  userA   User              @relation("CoupleUserA", fields: [userAId], references: [id], onDelete: Restrict)
  userBId String?           @unique
  userB   User?             @relation("CoupleUserB", fields: [userBId], references: [id], onDelete: Restrict)
  status  CoupleSpaceStatus @default(PENDING)
  origin  String            @default("EXTERNAL") // MATCH | EXTERNAL

  // Clé canonique "plus-petit-id:plus-grand-id". L'index unique empêche deux
  // espaces pour la même paire, même si les rôles A/B sont inversés.
  pairKey String? @unique
  matchId String? @unique
  match   Match?  @relation(fields: [matchId], references: [id], onDelete: SetNull)

  // inviteCode n'est conservé que pour rendre la migration de l'ancien schéma
  // compatible. Les nouveaux codes ne sont jamais persistés en clair : seuls
  // leur HMAC, leur destinataire et leur expiration le sont.
  inviteCode      String?   @unique
  inviteCodeHash  String?   @unique
  inviteEmailHash String?
  inviteExpiresAt DateTime?

  season                LifeSeason  @default(MARRIED)
  // Une transition de saison n'est appliquée qu'après confirmation de l'autre
  // membre. Les deux champs sont posés/effacés ensemble par CAS.
  seasonRequestedBy     String?
  seasonRequestedTarget LifeSeason?
  seasonRequestedAt     DateTime?
  marriedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  agentInsights AgentInsight[]
  messages      CoupleMessage[]
  gameRounds    GameRound[]

  // Requêtes app/api/couple/**/*.ts : findFirst OR(userAId, userBId) + status
  // (route.ts, season/route.ts), et userBId + status (messages/route.ts).
  // userAId/userBId sont déjà @unique (index implicite par colonne) mais ne
  // couvrent pas le filtre status combiné.
  @@index([userAId, status])
  @@index([userBId, status])
}

// Messagerie privée entre les deux conjoints d'un Espace Couple. Indépendante du
// matching (modèle Message, lui, est lié à Match) : ici pas de modération - c'est
// une conversation privée entre époux. Contenu chiffré au repos (encryptField).
model CoupleMessage {
  id               String      @id @default(cuid())
  spaceId          String
  space            CoupleSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User        @relation("CoupleMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  contentEncrypted String
  createdAt        DateTime    @default(now())

  @@index([spaceId, createdAt])
  @@index([senderId])
}

model FaithProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  vertical              FaithVertical   @default(CHRISTIAN_EVANGELICAL)
  denomination          String?
  ministry              String?
  engagementFrequency   String?
  localChurchEncrypted  String?
  localChurchVisibility VisibilityLevel @default(AFTER_DISCERNMENT)
  testimonyEncrypted    String?
  testimonyVisibility   VisibilityLevel @default(AFTER_MATCH)
}

model RelationshipProfile {
  id                     String          @id @default(cuid())
  userId                 String          @unique
  user                   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  maritalStatus          String
  hasChildren            Boolean         @default(false)
  childrenVisibility     VisibilityLevel @default(AFTER_MATCH)
  wantsChildren          Boolean?
  acceptsChildren        Boolean?
  familyVisionEncrypted  String?
  familyVisionVisibility VisibilityLevel @default(AFTER_DIALOGUE)
  intentionStatement     String?
  intentionVisibility    VisibilityLevel @default(PUBLIC_CONTROLLED)
  interests              String?
  personality            String?
  aspirations            String?
}

model PrivacySettings {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  antiMalaiseEnabled  Boolean @default(true)
  antiMalaiseRadiusKm Int     @default(25)
  invisibleMode       Boolean @default(false)
  fieldVisibility     Json?
}

model Match {
  id                         String                @id @default(cuid())
  userAId                    String
  userBId                    String
  userA                      User                  @relation("MatchUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB                      User                  @relation("MatchUserB", fields: [userBId], references: [id], onDelete: Cascade)
  stage                      AllianceStage         @default(DISCOVERY)
  status                     MatchStatus           @default(PENDING)
  compatibilityJson          Json?
  contactExchange            ContactExchangeStatus @default(NOT_ALLOWED)
  // Identifie l'auteur de la demande afin que seul l'autre membre puisse
  // l'accepter. Null hors de l'état REQUESTED.
  contactExchangeRequestedBy String?
  advanceRequestedBy         String?
  requestedById              String?
  closedBy                   String?
  closeMessage               String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  lastReadAtUserA            DateTime?
  lastReadAtUserB            DateTime?

  messages        Message[]
  allianceAnswers AllianceAnswer[]
  agentInsights   AgentInsight[]
  gameRounds      GameRound[]
  coupleSpace     CoupleSpace?
  blessings       Blessing[]

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([userAId, lastReadAtUserA])
  @@index([userBId, lastReadAtUserB])
  // Liste des matchs (app/api/matches/list/route.ts) : OR(userAId, userBId)
  // trié par updatedAt desc. Couvre chaque branche du OR avec le tri.
  @@index([userAId, updatedAt])
  @@index([userBId, updatedAt])
}

model Message {
  id               String           @id @default(cuid())
  matchId          String
  match            Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId         String
  sender           User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  contentEncrypted String
  kind             MessageKind      @default(USER)
  moderationStatus ModerationStatus @default(SAFE)
  blockedReason    String?
  createdAt        DateTime         @default(now())

  @@index([matchId, createdAt])
}

model AllianceAnswer {
  id              String        @id @default(cuid())
  matchId         String
  match           Match         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  stage           AllianceStage
  questionId      String
  // Colonne historique conservée uniquement pendant le backfill 0022.
  // Toute nouvelle écriture doit utiliser answerEncrypted.
  answerLegacy    String        @map("answer")
  answerEncrypted String?
  createdAt       DateTime      @default(now())

  @@unique([matchId, userId, questionId])
}

model Consent {
  id                    String                 @id @default(cuid())
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  ConsentType
  // Les consentements historiques restent valides dans leur périmètre initial.
  // Ces dimensions sont nullables uniquement pour permettre une migration sûre
  // sans transformer les lignes existantes en consentements implicites.
  version               String?
  purpose               String?
  recipient             String?
  grantedAt             DateTime               @default(now())
  revokedAt             DateTime?
  aiCoachTransferLeases AiCoachTransferLease[]

  @@index([userId, type])
  @@index([userId, type, version, revokedAt])
}

// Bail technique très court d'un transfert Coach IA déjà admis.
// Il rend la révocation linéarisable sans garder une transaction ou une
// connexion PostgreSQL ouverte pendant l'appel réseau.
model AiCoachTransferLease {
  id         String   @id
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentId  String
  consent    Consent  @relation(fields: [consentId], references: [id], onDelete: Cascade)
  admittedAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId, admittedAt, expiresAt])
  @@index([expiresAt])
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUserId String
  target       User         @relation("ReportTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  reason       String
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?

  @@index([targetUserId, status])
  // File de modération (app/api/admin/reports/route.ts) : filtre status IN
  // [OPEN, REVIEWING] SANS targetUserId, trié par createdAt desc. L'index
  // ci-dessus (targetUserId en tête) ne peut pas servir cette requête.
  @@index([status, createdAt])
}

model Coach {
  id                 String    @id @default(cuid())
  displayName        String
  photoUrl           String?
  certified          Boolean   @default(false)
  specialties        String[]
  affiliation        String
  bio                String?
  pricePerSessionEUR Int
  ratingAvg          Float     @default(0)
  reviewsCount       Int       @default(0)
  bookings           Booking[]
}

model Booking {
  id        String        @id @default(cuid())
  coachId   String
  coach     Coach         @relation(fields: [coachId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotStart DateTime
  status    BookingStatus @default(PENDING)
  createdAt DateTime      @default(now())

  @@unique([coachId, slotStart])
  @@index([userId])
}

// Productions des agents intelligents (portrait de préparation, bilans,
// signaux de vigilance, résumés coach). Toujours soumis à un VisibilityLevel
// et révocables - jamais exposés à l'autre membre.
model AgentInsight {
  id            String          @id @default(cuid())
  userId        String?
  user          User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId       String?
  match         Match?          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  agentId       String
  kind          String
  coupleSpaceId String?
  coupleSpace   CoupleSpace?    @relation(fields: [coupleSpaceId], references: [id], onDelete: Cascade)
  dataJson      Json
  visibility    VisibilityLevel @default(PRIVATE)
  createdAt     DateTime        @default(now())
  revokedAt     DateTime?

  @@index([userId, agentId])
  @@index([matchId, agentId])
  @@index([agentId, revokedAt])
  @@index([coupleSpaceId])
}

model AiCoachUsage {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day    DateTime @db.Date
  count  Int      @default(0)

  @@unique([userId, day])
}

// Persistance des échanges avec le Coach IA. Contenu chiffré au repos
// (sujets sensibles). `mode` sépare les fils individuel / couple.
model CoachMessage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode             String   @default("individual")
  role             String
  contentEncrypted String
  guardrail        Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([userId, mode, createdAt])
}

// Abonnement Web Push (PWA, iOS 16.4+ / Android). Un device = un endpoint.
// `endpoint` est l'URL du service push du navigateur (unique). `p256dh`/`auth`
// sont les clés de chiffrement du payload fournies par le navigateur.
// Purge automatique sur 404/410 lors d'un envoi (cf. lib/push.ts).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Parrain / Marraine - proche de confiance (famille, pasteur·e, prêtre, ami·e)
// désigné par l'utilisateur, PAR EMAIL, sans compte app. Ne lit jamais les
// conversations : présence (badge de transparence) + bénédiction sur demande.
// 1 par utilisateur (MVP). Voir docs/superpowers/specs/2026-06-18-parrain-marraine-design.md
model Sponsor {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation("UserSponsor", fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String
  relation  String // family | pastor | priest | friend
  createdAt DateTime   @default(now())
  blessings Blessing[]
}

enum BlessingStatus {
  PENDING
  BLESSED
  CAUTION
}

// Demande de bénédiction : l'utilisateur (filleul·e) demande l'avis de son
// Parrain/Marraine avant d'avancer dans une mise en relation. Le bearer brut
// n'est jamais persisté : tokenHash contient uniquement son SHA-256. Une
// demande PENDING est expirante et n'est utilisable qu'après confirmation de
// l'envoi email. Les réponses historiques n'ont plus aucun bearer utilisable.
model Blessing {
  id            String         @id @default(cuid())
  sponsorId     String?
  sponsor       Sponsor?       @relation(fields: [sponsorId], references: [id], onDelete: SetNull)
  matchId       String
  match         Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation("BlessingUser", fields: [userId], references: [id], onDelete: Cascade)
  tokenHash     String?        @unique
  expiresAt     DateTime?
  emailSentAt   DateTime?
  status        BlessingStatus @default(PENDING)
  noteEncrypted String?
  createdAt     DateTime       @default(now())
  respondedAt   DateTime?

  // La migration ajoute aussi un index UNIQUE partiel sur (userId, matchId)
  // WHERE status = 'PENDING'. Prisma ne sait pas encore exprimer cet index.
  @@index([userId, matchId, status])
  @@index([matchId])
}

// =====================================================================
// ECOSYSTEME ORGANIQUE : profils Compagnons IA badges, vivant nativement
// dans la Decouverte et la messagerie (cold start). Toujours transparents,
// jamais presentes comme de vraies personnes, jamais un vrai match.
// =====================================================================

enum ProfileKind {
  HUMAN
  AI_COMPANION
}

/// Configuration d'un Compagnon IA (1:1 avec un User dont kind == AI_COMPANION).
model AiCompanionMeta {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  systemPrompt String // posture + ancrage culturel
  langAnchor   String // ancre bilingue (langue du 1er message)
  temperament  String // "warm" | "analytical" | "expressive" | "reserved"...
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Jeu de couple/match (construction C, hybride, SANS FIN) ──────────────────
// Deux modes de manche : SHARED (les deux répondent honnêtement, scellé jusqu'à
// ce que les deux aient répondu) et GUESS (l'initiateur répond honnêtement,
// l'autre devine ; verdict simple au reveal). Une manche = un GameRound
// polymorphe rattaché SOIT à un Match SOIT à un Espace Couple (exactement un des
// deux non-null). Le contenu chiffré (answerEncrypted/guessEncrypted) n'est
// JAMAIS renvoyé à l'autre joueur tant que status != REVEALED (filtré côté API).
enum GameMode {
  SHARED
  GUESS
}

enum GameRoundStatus {
  OPEN
  REVEALED
}

// Une manche du jeu. Surface polymorphe : matchId XOR coupleSpaceId (exactement
// un non-null). questionKey pointe la banque i18n curatée ; questionText n'est
// rempli que si la question a été générée par l'IA (banque épuisée). Au reveal,
// le backend poste un message (Message SYSTEM pour un match, CoupleMessage pour
// un couple) et stocke son id dans resultMessageId.
model GameRound {
  id              String          @id @default(cuid())
  matchId         String?
  match           Match?          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  coupleSpaceId   String?
  coupleSpace     CoupleSpace?    @relation(fields: [coupleSpaceId], references: [id], onDelete: Cascade)
  mode            GameMode
  questionKey     String? // clé i18n de la banque curatée
  questionText    String? // rempli seulement si question générée par IA
  initiatorId     String
  initiator       User            @relation("GameRoundInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  status          GameRoundStatus @default(OPEN)
  resultMessageId String? // id du Message / CoupleMessage posté au reveal
  createdAt       DateTime        @default(now())
  revealedAt      DateTime?

  answers GameRoundAnswer[]

  @@index([matchId, createdAt])
  @@index([coupleSpaceId, createdAt])
}

// Réponse d'un joueur pour une manche. answerEncrypted = sa réponse HONNÊTE
// (chiffrée). guessEncrypted = ce que ce joueur DEVINE de la réponse de l'autre
// (mode GUESS uniquement, chiffré). Une ligne par (round, user).
model GameRoundAnswer {
  id              String    @id @default(cuid())
  roundId         String
  round           GameRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation("GameRoundAnswerUser", fields: [userId], references: [id], onDelete: Cascade)
  answerEncrypted String? // réponse honnête chiffrée
  guessEncrypted  String? // devinette chiffrée (mode GUESS)
  createdAt       DateTime  @default(now())

  @@unique([roundId, userId])
