    "@upstash/redis": "^1.38.0",
    "blurhash": "^2.0.5",
    "jose": "^6.2.4",
    "next": "16.2.11",
    "next-intl": "^4.13.4",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.0",
    "stripe": "^22.3.2",
    "web-push": "^3.6.7",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "15.5.21",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
