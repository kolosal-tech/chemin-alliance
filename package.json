{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:account-deletion-db": "tsx scripts/validate-account-deletion.ts",
    "test:ai-consent-db": "tsx scripts/validate-ai-coach-consent-linearization.ts",
