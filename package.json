    "test:e2e-fixtures": "tsx scripts/prepare-e2e-fixtures.ts",
    "e2e": "playwright test",
    "e2e:report": "node scripts/generate-summary.mjs",
    "seed": "tsx prisma/seed.ts",
    "seed:ecosystem": "tsx prisma/seed-ecosystem.ts",
    "backfill:blurhash": "tsx scripts/backfill-blurhash.ts",
    "backfill:agent-insights": "tsx scripts/backfill-agent-insights.ts",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
